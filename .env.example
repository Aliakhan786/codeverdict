# Copy this file to .env and fill in your values. .env is git-ignored - never commit it.
# Write values without quotes: GEMINI_API_KEY=AIza...

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = fastest answers; -1 = let the model think (slower, sometimes better)
GEMINI_THINKING_BUDGET=0

# At least 32 random characters in production (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

DB_PASSWORD=codeverdict

# Creates demo / demo1234 with the starter problems
DEMO_ENABLED=true
